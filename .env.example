# PostgreSQL connection string for the dedicated private-assistant role.
DATABASE_URL=postgresql://private_reply_app:change-me@127.0.0.1:5432/private_reply_assistant

# Exactly 32 random bytes encoded as canonical base64. Keep keys outside the database.
APP_ENCRYPTION_KEY=
SESSION_SIGNING_KEY=

# Argon2id hash of the single private login password; never place the plaintext here.
APP_PASSWORD_HASH=

# The provider is instructed not to store model responses, but still processes plaintext.
OPENAI_API_KEY=
ANALYSIS_MODEL=
REPLY_MODEL=
EMBEDDING_MODEL=
